#!/bin/bash
# kcs - KaisarCode Standards Validator
# Summary: Validates KaisarCode files against formatting and standards rules.
# Author:  KaisarCode
# Website: https://kaisarcode.com
# License: https://www.gnu.org/licenses/gpl-3.0.html

set -e
set -o pipefail

# Prints application usage help.
# @return 0 on success.
kc_kcs_help() {
    echo "Usage: kcs [options] <file|dir>..."
    echo
    echo "Options:"
    echo "  -type <t>        Force file type: sh|shell|c|cpp|php|js|md|lua"
    echo "  -e, --exclude <p> Exclude path pattern"
    echo "  -s, --stop        Stop on the first validation failure"
    echo "  -p, --pass        Show successful validation checks"
    echo "  <file|dir>...    Validate one or more files or directories"
    echo "  -h, --help       Show help"
    echo
    echo "Supported file types:"
    echo "  Shell"
    echo "  C / C++"
    echo "  PHP"
    echo "  JavaScript"
    echo "  Markdown"
    echo "  Lua"
    echo
    echo "Examples:"
    echo "  kcs -type shell ./script.txt"
    echo "  kcs ./script.sh"
    echo "  kcs ./README.md"
    echo "  kcs ."
    echo "  kcs -s ."
    echo "  kcs -p ."
    echo "  kcs . --stop"
    echo
    echo "Dependencies:"
    echo "  shellcheck"
}

# Prints one error and the help text to standard error.
# @param $1 Error message
# @return 1 on failure.
kc_kcs_fail() {
    echo "Error: $1" >&2
    kc_kcs_help >&2
    return 1
}

# Prints failure details to standard error.
# @param message Error description.
# @return 1 on failure.
fail() {
    printf "\033[31m[FAIL]\033[0m %s\n" "$1" >&2
    KC_KCS_FAILURE_COUNT=$((KC_KCS_FAILURE_COUNT + 1))
    if [ "$KC_KCS_STOP_ON_FAILURE" -eq 1 ]; then
        return 1
    fi
    return 0
}

# Prints informational details to standard output.
# @param message Information description.
# @return 0 on success.
info() {
    if [ "$KC_KCS_SHOW_PASS" -eq 1 ]; then
        printf "\033[36m[INFO]\033[0m %s\n" "$1"
    fi
}

# Prints success details to standard output.
# @param message Success description.
# @return 0 on success.
pass() {
    if [ "$KC_KCS_SHOW_PASS" -eq 1 ]; then
        printf "\033[32m[PASS]\033[0m %s\n" "$1"
    fi
}

# Normalizes one CLI file type alias into the internal type name.
# @param $1 Raw type alias
# @return 0 on success, 1 on failure.
normalize_file_type() {
    case "$1" in
        sh|shell)
            echo "shell"
            return 0
            ;;
        c|cpp)
            echo "c"
            return 0
            ;;
        php)
            echo "php"
            return 0
            ;;
        js|javascript)
            echo "js"
            return 0
            ;;
        md|markdown)
            echo "markdown"
            return 0
            ;;
        lua)
            echo "lua"
            return 0
            ;;
    esac
    return 1
}

# Determines file type by inspecting shebangs or content.
# @param file Path to the file.
# @return string "shell", "c", "php", "markdown", or "unknown".
get_file_type() {
    if [ -n "$KC_KCS_FORCE_TYPE" ]; then
        echo "$KC_KCS_FORCE_TYPE"
        return 0
    fi
    local file="$1"
    [ -f "$file" ] && [ -r "$file" ] || return
    local sample
    local first_line
    sample=$(head -n 5 "$file" 2>/dev/null | tr -d '\0')
    first_line=$(printf '%s' "$sample" | awk 'NR == 1 { print; exit }')
    if [[ "$first_line" =~ ^#!.*(bash|sh)$ ]]; then echo "shell"; return; fi
    if [[ "$first_line" =~ ^#!.*(qjs|node)$ ]]; then echo "js"; return; fi
    case "$file" in
        *.c|*.h|*.cpp|*.hpp) echo "c" ;;
        *.php) echo "php" ;;
        *.js|*.mjs) echo "js" ;;
        *.md) echo "markdown" ;;
        *.lua) echo "lua" ;;
        *) echo "unknown" ;;
    esac
}

# Validates that filenames use kebab-case instead of snake_case.
# Exception is made for files representing class names.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_filename() {
    local file_path="$1"
    local filename
    filename=$(basename "$file_path")
    local name="${filename%.*}"
    if [[ "$name" =~ [A-Z] ]]; then
        return 0
    fi
    if [[ "$name" == *"_"* ]]; then
        fail "$file_path:1 Filename must use hyphens '-' instead of underscores '_' to separate words."
    fi
}

# Validates whitespace, indentation, and blank lines.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_whitespace_and_limits() {
    local file_path="$1"
    local ftype
    local bad_line
    ftype=$(get_file_type "$file_path")
    bad_line=$(grep -n $'\t' "$file_path" | head -n 1 | cut -d: -f1 || true)
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line Tabs are forbidden."
    fi
    case "$ftype" in
        c|php)
            bad_line=$(awk '
                /^[[:space:]]*\/\*\*/ {
                    in_docblock = 1
                    next
                }
                in_docblock {
                    if (/\*\//) {
                        in_docblock = 0
                    }
                    next
                }
                /^[ ]+/ {
                    match($0, /^ +/)
                    if (RLENGTH % 4 != 0) { print NR; exit }
                }
            ' "$file_path" || true)
            ;;
        js)
            bad_line=$(awk '
                BEGIN { sq = sprintf("%c", 39) }
                {
                    in_code = (in_tmpl == 0 && in_str == "" && in_doc == 0)
                    line = $0
                    if (in_code && line ~ /^[ ]+/) {
                        match(line, /^ +/)
                        if (RLENGTH % 4 != 0) { print NR; exit }
                    }
                    n = length(line)
                    for (i = 1; i <= n; i++) {
                        c = substr(line, i, 1)
                        if (in_tmpl) {
                            if (c == "\\") { i++; continue }
                            if (c == "`") { in_tmpl = 0 }
                            continue
                        }
                        if (in_str != "") {
                            if (c == "\\") { i++; continue }
                            if (c == in_str) { in_str = "" }
                            continue
                        }
                        if (in_doc) {
                            if (c == "*" && i < n && substr(line, i + 1, 1) == "/") { in_doc = 0; i++ }
                            continue
                        }
                        if (c == "\"" || c == sq) { in_str = c; continue }
                        if (c == "`") { in_tmpl = 1; continue }
                        if (c == "/" && i < n) {
                            nxt = substr(line, i + 1, 1)
                            if (nxt == "*") {
                                in_doc = 1
                                i++
                            } else if (nxt == "/") {
                                break
                            }
                        }
                    }
                }
            ' "$file_path" || true)
            ;;
        markdown)
            bad_line=$(awk '
                /^```/ {
                    in_fence = !in_fence
                    next
                }
                in_fence { next }
                /^[ ]+/ {
                    match($0, /^ +/)
                    if (RLENGTH % 4 != 0) { print NR; exit }
                }
            ' "$file_path" || true)
            ;;
        lua)
            bad_line=$(awk '
                /^[ ]+/ {
                    match($0, /^ +/)
                    if (RLENGTH % 4 != 0) { print NR; exit }
                }
            ' "$file_path" || true)
            ;;
        *)
            bad_line=$(awk '
                function start_heredoc(line,    rest, quote, squote) {
                    if (line !~ /<<-?/) return 0
                    rest = line
                    sub(/^.*<<-?/, "", rest)
                    sub(/^[[:space:]]*/, "", rest)
                    squote = sprintf("%c", 39)
                    quote = substr(rest, 1, 1)
                    if (quote == "\"" || quote == squote) {
                        rest = substr(rest, 2)
                        sub(quote ".*$", "", rest)
                        heredoc = rest
                        return 1
                    }
                    if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                        heredoc = substr(rest, RSTART, RLENGTH)
                        return 1
                    }
                    return 0
                }
                heredoc {
                    end = $0
                    sub(/^[[:space:]]*/, "", end)
                    if (end == heredoc) heredoc = ""
                    next
                }
                /^[ ]+/ {
                    match($0, /^ +/)
                    if (RLENGTH % 4 != 0) { print NR; exit }
                }
                { start_heredoc($0) }
            ' "$file_path" || true)
            ;;
    esac
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line Indentation must use 4-space increments."
    fi
    if [ "$ftype" = "shell" ]; then
        bad_line=$(awk '
            function start_heredoc(line,    rest, quote, squote) {
                if (line !~ /<<-?/) return 0
                rest = line
                sub(/^.*<<-?/, "", rest)
                sub(/^[[:space:]]*/, "", rest)
                squote = sprintf("%c", 39)
                quote = substr(rest, 1, 1)
                if (quote == "\"" || quote == squote) {
                    rest = substr(rest, 2)
                    sub(quote ".*$", "", rest)
                    heredoc = rest
                    return 1
                }
                if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                    heredoc = substr(rest, RSTART, RLENGTH)
                    return 1
                }
                return 0
            }
            heredoc {
                end = $0
                sub(/^[[:space:]]*/, "", end)
                if (end == heredoc) heredoc = ""
                next
            }
            /^[[:space:]]*$/ {
                blank_count++
                if (blank_count > 1) { print NR; exit }
                next
            }
            { blank_count = 0; start_heredoc($0) }
        ' "$file_path" || true)
    elif [ "$ftype" = "js" ]; then
        bad_line=$(awk '
            BEGIN { sq = sprintf("%c", 39) }
            {
                line = $0
                if (line ~ /^[[:space:]]*$/) {
                    if (in_tmpl == 0 && in_str == "" && in_doc == 0) {
                        blank_count++
                        if (blank_count > 1) { print NR; exit }
                    }
                } else {
                    blank_count = 0
                }
                n = length(line)
                for (i = 1; i <= n; i++) {
                    c = substr(line, i, 1)
                    if (in_tmpl) {
                        if (c == "\\") { i++; continue }
                        if (c == "`") { in_tmpl = 0 }
                        continue
                    }
                    if (in_str != "") {
                        if (c == "\\") { i++; continue }
                        if (c == in_str) { in_str = "" }
                        continue
                    }
                    if (in_doc) {
                        if (c == "*" && i < n && substr(line, i + 1, 1) == "/") { in_doc = 0; i++ }
                        continue
                    }
                    if (c == "\"" || c == sq) { in_str = c; continue }
                    if (c == "`") { in_tmpl = 1; continue }
                    if (c == "/" && i < n) {
                        nxt = substr(line, i + 1, 1)
                        if (nxt == "*") {
                            in_doc = 1
                            i++
                        } else if (nxt == "/") {
                            break
                        }
                    }
                }
            }
        ' "$file_path" || true)
    elif [ "$ftype" = "lua" ]; then
        bad_line=$(awk '
            /^[[:space:]]*$/ {
                blank_count++
                if (blank_count > 1) { print NR; exit }
                next
            }
            { blank_count = 0 }
        ' "$file_path" || true)
    else
        bad_line=$(awk '
            /^[[:space:]]*$/ {
                blank_count++
                if (blank_count > 1) { print NR; exit }
                next
            }
            { blank_count = 0 }
        ' "$file_path" || true)
    fi
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line Multiple consecutive blank lines are forbidden."
    fi
    if [ -s "$file_path" ]; then
        local last_byte
        local last_two_bytes
        last_byte=$(tail -c 1 "$file_path" | od -An -t x1 | tr -d ' \n')
        last_two_bytes=$(tail -c 2 "$file_path" | od -An -t x1 | tr -d ' \n')
        bad_line=$(wc -l < "$file_path")
        if [ "$last_byte" != "0a" ]; then
            bad_line=$((bad_line + 1))
            fail "$file_path:$bad_line File must end with exactly one newline."
        fi
        if [ "$last_two_bytes" = "0a0a" ]; then
            [ "$bad_line" -gt 0 ] || bad_line=1
            fail "$file_path:$bad_line File must end with exactly one newline."
        fi
    fi
    pass "$file_path: Whitespace verified."
}

# Ensures DocBlock lines do not exceed 80 chars.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_docblock_format() {
    local file_path="$1"
    local ftype
    ftype=$(get_file_type "$file_path")
    local bad_line
    case "$ftype" in
        shell)
            bad_line=$(awk '
                NR <= 20 { next }
                /^[[:space:]]*# / {
                    if (length($0) > 80) { print NR; exit }
                }
            ' "$file_path" || true)
            ;;
        c|php|js)
            bad_line=$(awk '
                NR <= 20 { next }
                /^[[:space:]]*\/\*\*/ {
                    if (NR > 1 && prev_nonblank != "" && prev_nonblank !~ /^[[:space:]]*#/) {
                        print NR
                        exit
                    }
                    in_docblock = 1
                    if (length($0) > 80) { print NR; exit }
                    next
                }
                in_docblock && /\*\// {
                    in_docblock = 0
                    prev_nonblank = $0
                    next
                }
                in_docblock && /^[[:space:]]*\*/ {
                    if (length($0) > 80) { print NR; exit }
                    next
                }
                /^[[:space:]]*#/ {
                    prev_nonblank = $0
                    next
                }
                /^[[:space:]]*$/ { prev_nonblank = ""; next }
                { prev_nonblank = $0 }
            ' "$file_path" || true)
            ;;
        lua)
            bad_line=$(awk '
                NR <= 20 { next }
                /^[[:space:]]*--/ {
                    if (NR > 1 && prev_nonblank != "") {
                        print NR
                        exit
                    }
                    in_docblock = 1
                    if (length($0) > 80) { print NR; exit }
                    next
                }
                in_docblock && /^[[:space:]]*--/ {
                    if (length($0) > 80) { print NR; exit }
                    next
                }
                /^[[:space:]]*$/ { prev_nonblank = ""; next }
                { prev_nonblank = $0 }
            ' "$file_path" || true)
            ;;
        *)
            bad_line=
            ;;
    esac
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line DocBlock exceeds 80 chars."
    fi
    pass "$file_path: DocBlock format verified."
}

# Requires one blank line before every DocBlock.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success.
validate_docblock_spacing() {
    local file_path="$1"
    local ftype="$2"
    local bad_line
    case "$ftype" in
        shell)
            bad_line=$(awk '
                function start_heredoc(line,    rest, quote, squote) {
                    if (line !~ /<<-?/) return 0
                    rest = line
                    sub(/^.*<<-?/, "", rest)
                    sub(/^[[:space:]]*/, "", rest)
                    squote = sprintf("%c", 39)
                    quote = substr(rest, 1, 1)
                    if (quote == "\"" || quote == squote) {
                        rest = substr(rest, 2)
                        sub(quote ".*$", "", rest)
                        heredoc = rest
                        return 1
                    }
                    if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                        heredoc = substr(rest, RSTART, RLENGTH)
                        return 1
                    }
                    return 0
                }
                BEGIN { in_header = 1 }
                heredoc {
                    end = $0
                    sub(/^[[:space:]]*/, "", end)
                    if (end == heredoc) heredoc = ""
                    next
                }
                NR == 1 && /^#!/ { next }
                in_header && /^[[:space:]]*#([[:space:]].*)?$/ { next }
                in_header && /^[[:space:]]*$/ {
                    in_header = 0
                    prev_blank = 1
                    next
                }
                /^[[:space:]]*# shellcheck/ { next }
                /^[[:space:]]*# / {
                    if (NR > 1 && prev_blank == 0) {
                        print NR
                        exit
                    }
                    in_docblock = 1
                    next
                }
                /^[[:space:]]*$/ {
                    prev_blank = 1
                    in_docblock = 0
                    next
                }
                {
                    in_header = 0
                    prev_blank = 0
                    in_docblock = 0
                    start_heredoc($0)
                }
            ' "$file_path" || true)
            ;;
        c|php|js)
            bad_line=$(awk '
                /^[[:space:]]*\/\*\*/ {
                    if (NR > 1 && prev_blank == 0 && !prev_preproc) {
                        print NR
                        exit
                    }
                    in_docblock = 1
                    next
                }
                in_docblock {
                    if ($0 ~ /\*\//) {
                        in_docblock = 0
                    }
                    next
                }
                /^[[:space:]]*(#|<\?php)/ {
                    prev_blank = 0
                    prev_preproc = 1
                    next
                }
                /^[[:space:]]*$/ {
                    prev_blank = 1
                    prev_preproc = 0
                    next
                }
                {
                    prev_blank = 0
                    prev_preproc = 0
                }
            ' "$file_path" || true)
            ;;
        lua)
            bad_line=$(awk '
                BEGIN { in_header = 1 }
                NR == 1 && /^#!/ { next }
                in_header && /^[[:space:]]*--/ { next }
                in_header && /^[[:space:]]*$/ {
                    in_header = 0
                    prev_blank = 1
                    next
                }
                in_header { in_header = 0 }
                /^[[:space:]]*--/ {
                    if (NR > 1 && prev_blank == 0) {
                        print NR
                        exit
                    }
                    in_docblock = 1
                    next
                }
                in_docblock && !/^[[:space:]]*--/ {
                    in_docblock = 0
                    next
                }
                /^[[:space:]]*$/ {
                    prev_blank = 1
                    next
                }
                {
                    prev_blank = 0
                }
            ' "$file_path" || true)
            ;;
        *)
            bad_line=
            ;;
    esac
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line Missing blank line before DocBlock."
    fi
    pass "$file_path: DocBlock spacing verified."
}

# Validates objective shell-specific requirements.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_shell_rules() {
    local file_path="$1"
    local first_line
    first_line=$(head -n 1 "$file_path")
    case "$first_line" in
        '#!/bin/sh'|'#!/bin/bash')
            ;;
        *)
            fail "$file_path:1 Shell shebang must be /bin/sh or /bin/bash."
            ;;
    esac
    if ! command -v shellcheck >/dev/null 2>&1; then
        info "$file_path: shellcheck not installed, skipped."
        return 0
    fi
    local shellcheck_output
    local shellcheck_line
    if ! shellcheck_output=$(shellcheck -P SCRIPTDIR -x -f gcc "$file_path" 2>&1); then
        shellcheck_line=$(printf '%s\n' "$shellcheck_output" | awk -F: '
            NR == 1 && $2 ~ /^[0-9]+$/ { print $2; exit }
        ')
        [ -n "$shellcheck_line" ] || shellcheck_line=1
        fail "$file_path:$shellcheck_line shellcheck validation failed."
    fi
    pass "$file_path: Shell rules verified."
}

# Validates markdown-specific requirements.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_markdown_rules() {
    local file_path="$1"
    local h1_count
    local bad_line
    local h1_data
    h1_data=$(awk '
        /^```/ { in_fence = !in_fence; next }
        in_fence { next }
        /^# / {
            count++
            if (count == 2 && extra == 0) extra = NR
        }
        END {
            if (count == 0) extra = 1
            print count + 0, extra + 0
        }
    ' "$file_path")
    read -r h1_count bad_line <<< "$h1_data"
    if [ "$h1_count" -ne 1 ]; then
        fail "$file_path:$bad_line Markdown files must contain exactly one H1."
    fi
    pass "$file_path: Markdown rules verified."
}

# Scans for forbidden internal comments while protecting DocBlocks.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success.
validate_no_internal_comments() {
    local file_path="$1"
    local ftype="$2"
    if [ "$ftype" = "shell" ]; then
        local bad_line
        bad_line=$(awk -v h="#" -v s=" " '
            function start_heredoc(line,    rest, quote, squote) {
                if (line !~ /<<-?/) return 0
                rest = line
                sub(/^.*<<-?/, "", rest)
                sub(/^[[:space:]]*/, "", rest)
                squote = sprintf("%c", 39)
                quote = substr(rest, 1, 1)
                if (quote == "\"" || quote == squote) {
                    rest = substr(rest, 2)
                    sub(quote ".*$", "", rest)
                    heredoc = rest
                    return 1
                }
                if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                    heredoc = substr(rest, RSTART, RLENGTH)
                    return 1
                }
                return 0
            }
            BEGIN { in_header = 1 }
            heredoc {
                end = $0
                sub(/^[[:space:]]*/, "", end)
                if (end == heredoc) heredoc = ""
                next
            }
            NR == 1 && $0 ~ /^#!/ { next }
            in_header && $0 ~ "^"h { next }
            in_header && $0 ~ /^[[:space:]]*$/ { in_header = 0; next }
            in_header { in_header = 0 }
            $0 ~ "^"h {
                if (!in_docblock && $0 !~ "^"h" ([*@]|shellcheck|Summary:|Author:|Website:|License:|Email:|©|[a-z0-9_-]+ -|"s"|[A-Za-z].*)") {
                    print NR; exit
                }
                if ($0 ~ "^"h" shellcheck") {
                    next
                }
                if ($0 ~ /@return/) seen_return = 1
                if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ "^"h" (shellcheck|Summary:|Author:|Website:|License:|Email:|©|[a-z0-9_-]+ -)" && $0 ~ "^"h" [A-Za-z]") seen_summary = 1
                in_docblock = 1; next
            }
            $0 !~ /^[[:space:]]*#/ && index($0, s h) { print NR; exit }
            /^[[:space:]]*$/ { in_docblock = 0; seen_return = 0; seen_summary = 0 }
            /^[a-z_][a-z0-9_]*[ ]*\(\)/ {
                if (in_docblock && (!seen_return || !seen_summary)) { print NR; exit }
                in_docblock = 0; seen_return = 0; seen_summary = 0
            }
            { start_heredoc($0) }
            in_docblock {
                print NR; exit
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Forbidden internal comment, missing summary, or missing @return."
    elif [ "$ftype" = "c" ]; then
        local bad_line
        bad_line=$(awk -v sl="/" -v as="*" '
            function strip_strings(line,    out, i, ch, nextc, in_string, esc) {
                out = ""
                in_string = 0
                esc = 0
                for (i = 1; i <= length(line); i++) {
                    ch = substr(line, i, 1)
                    nextc = (i < length(line)) ? substr(line, i + 1, 1) : ""
                    if (!in_string) {
                        if (ch == "\"") {
                            in_string = 1
                            out = out " "
                        } else {
                            out = out ch
                        }
                        continue
                    }
                    if (esc) {
                        esc = 0
                        out = out " "
                        continue
                    }
                    if (ch == "\\") {
                        esc = 1
                        out = out " "
                        continue
                    }
                    if (ch == "\"") {
                        in_string = 0
                    }
                    out = out " "
                }
                return out
            }
            NR <= 20 { next }
            {
                scan = strip_strings($0)
            }
            index(scan, sl sl sl) { next }
            index(scan, sl sl) {
                if (NR > 20) { print NR; exit }
            }
            index(scan, sl as) && scan !~ /^[[:space:]]*\/\*\*/ {
                print NR; exit
            }
            scan ~ /^[[:space:]]*\/\*\*/ { in_docblock = 1 }
            in_docblock && /@return/ { seen_return = 1 }
            in_docblock && !/@param/ && !/@return/ && !/\* (Summary:|Author:|Website:|License:|Email:|©)/ && /\* [A-Za-z]/ { seen_summary = 1 }
            in_docblock && index(scan, as sl) {
                closing_line = NR
                next
            }
            closing_line && NR == closing_line + 1 {
                is_func = ($0 ~ /^[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^\)]*[;\{]?/ && $0 !~ /typedef/)
                if ((!seen_return || !seen_summary) && is_func) { print NR - 1; exit }
                in_docblock = 0; seen_return = 0; seen_summary = 0; closing_line = 0
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Forbidden internal comment, missing summary, or missing @return."
    elif [ "$ftype" = "js" ]; then
        local bad_line
        bad_line=$(awk '
            BEGIN { sq = sprintf("%c", 39) }
            NR <= 20 { next }
            {
                line = $0
                n = length(line)
                for (i = 1; i <= n; i++) {
                    c = substr(line, i, 1)
                    if (in_tmpl) {
                        if (c == "\\") { i++; continue }
                        if (c == "`") { in_tmpl = 0 }
                        continue
                    }
                    if (in_str != "") {
                        if (c == "\\") { i++; continue }
                        if (c == in_str) { in_str = "" }
                        continue
                    }
                    if (in_doc) {
                        if (c == "*" && i < n && substr(line, i + 1, 1) == "/") { in_doc = 0; i++ }
                        continue
                    }
                    if (c == "\"" || c == sq) { in_str = c; continue }
                    if (c == "`") { in_tmpl = 1; continue }
                    if (c == "/" && i < n) {
                        nxt = substr(line, i + 1, 1)
                        if (nxt == "/") { print NR; exit }
                        if (nxt == "*") {
                            if (i + 1 < n && substr(line, i + 2, 1) == "*") {
                                in_doc = 1
                                if (i + 2 < n && substr(line, i + 3, 1) == "/") { in_doc = 0 }
                                i += 2
                            } else {
                                print NR; exit
                            }
                        }
                    }
                }
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Forbidden internal comment."
    elif [ "$ftype" = "lua" ]; then
        local bad_line
        bad_line=$(awk '
            BEGIN { 
                in_header = 1 
                seen_summary = 0
                seen_author = 0
                seen_website = 0
                seen_license = 0
                in_docblock = 0
                docblock_has_tags = 0
            }
            {
                line = $0
                if (in_header) {
                    if (line ~ /^[[:space:]]*-- Summary:/) { seen_summary = 1; next }
                    if (line ~ /^[[:space:]]*-- Author:/) { seen_author = 1; next }
                    if (line ~ /^[[:space:]]*-- Website:/) { seen_website = 1; next }
                    if (line ~ /^[[:space:]]*-- License:/) { seen_license = 1; next }
                    if (line ~ /^[[:space:]]*$/) { next }
                    if (seen_summary && seen_author && seen_website && seen_license) {
                        # Header complete, but this could be a docblock or internal comment
                        # Process it normally below
                    } else if (line ~ /^[[:space:]]*-- /) {
                        next
                    }
                    in_header = 0
                }
                if (!in_header) {
                    is_comment = (line ~ /^[[:space:]]*--/)
                    is_blank = (line ~ /^[[:space:]]*$/)
                    
                    if (is_comment) {
                        if (line ~ /@return/ || line ~ /@param/) {
                            in_docblock = 1
                            docblock_has_tags = 1
                        } else if (in_docblock) {
                            # continue in docblock
                        } else if (line ~ /-- [A-Za-z]/) {
                            # potential docblock start with summary
                            in_docblock = 1
                            docblock_has_tags = 0
                        } else {
                            # comment without tags and not starting with summary
                            print NR; exit
                        }
                    } else if (!is_blank) {
                        # code line - check if we were in a docblock without tags
                        if (in_docblock && !docblock_has_tags) {
                            print NR - 1; exit
                        }
                        in_docblock = 0
                        docblock_has_tags = 0
                    }
                    
                    n = length(line)
                    for (i = 1; i <= n; i++) {
                        c = substr(line, i, 1)
                        if (in_str) {
                            if (c == "\\") { i++; continue }
                            if (c == in_str) { in_str = "" }
                            continue
                        }
                        if (in_long_str) {
                            if (c == "]" && i < n && substr(line, i + 1, 1) == "]") { in_long_str = 0; i++ }
                            continue
                        }
                        if (c == "\"" || c == "\047") { in_str = c; continue }
                        if (c == "[" && i < n && substr(line, i + 1, 1) == "[") { in_long_str = 1; i++; continue }
                        if (c == "-" && i < n) {
                            nxt = substr(line, i + 1, 1)
                            if (nxt == "-") {
                                if (i + 1 < n && substr(line, i + 2, 1) == "[") {
                                    if (i + 2 < n && substr(line, i + 3, 1) == "[") {
                                        in_long_str = 1
                                        i += 3
                                    } else {
                                        in_doc = 1
                                        i += 2
                                    }
                                }
                            }
                        }
                    }
                    if (in_doc && line !~ /^[[:space:]]*--/) in_doc = 0
                }
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Forbidden internal comment."
    fi
    pass "$file_path: No forbidden internal comments."
}

# Rejects stacked DocBlocks before one code item.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success.
validate_no_duplicate_docblocks() {
    local file_path="$1"
    local ftype="$2"
    local bad_line
    if [ "$ftype" = "c" ] || [ "$ftype" = "php" ] || [ "$ftype" = "js" ] || [ "$ftype" = "lua" ]; then
        bad_line=$(awk '
            in_docblock && /^[[:space:]]*--/ {
                if ($0 ~ /Summary:|Author:|Website:|License:/) {
                    is_header = 1
                }
                next
            }
            /^[[:space:]]*--/ {
                if (docblock_ready) {
                    print NR
                    exit
                }
                in_docblock = 1
                is_header = 0
                next
            }
            in_docblock && !/^[[:space:]]*--/ {
                in_docblock = 0
                if (!is_header) {
                    docblock_ready = 1
                }
                next
            }
            /^[[:space:]]*$/ {
                in_docblock = 0
                next
            }
            {
                docblock_ready = 0
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Duplicate DocBlock."
    fi
    pass "$file_path: Duplicate DocBlocks verified."
}

# Requires a DocBlock immediately before each function definition.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success.
validate_function_docblocks() {
    local file_path="$1"
    local ftype="$2"
    local bad_line
    if [ "$ftype" = "shell" ]; then
        bad_line=$(awk '
            function start_heredoc(line,    rest, quote, squote) {
                if (line !~ /<<-?/) return 0
                rest = line
                sub(/^.*<<-?/, "", rest)
                sub(/^[[:space:]]*/, "", rest)
                squote = sprintf("%c", 39)
                quote = substr(rest, 1, 1)
                if (quote == "\"" || quote == squote) {
                    rest = substr(rest, 2)
                    sub(quote ".*$", "", rest)
                    heredoc = rest
                    return 1
                }
                if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                    heredoc = substr(rest, RSTART, RLENGTH)
                    return 1
                }
                return 0
            }
            heredoc {
                end = $0
                sub(/^[[:space:]]*/, "", end)
                if (end == heredoc) heredoc = ""
                next
            }
            /^[[:space:]]*# / {
                if ($0 ~ /^[[:space:]]*# shellcheck/) {
                    next
                }
                in_docblock = 1
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /# (shellcheck|Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /# [A-Za-z]/) {
                    seen_summary = 1
                }
                next
            }
            /^[[:space:]]*$/ {
                in_docblock = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            /^[a-z_][a-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{/ {
                if (!in_docblock || !seen_return || !seen_summary) { print NR; exit }
                in_docblock = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            {
                in_docblock = 0
                seen_return = 0
                seen_summary = 0
                start_heredoc($0)
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Missing function DocBlock or summary."
    elif [ "$ftype" = "c" ] || [ "$ftype" = "php" ]; then
        local php_flag=0
        [ "$ftype" = "php" ] && php_flag=1
        bad_line=$(awk -v php="$php_flag" '
            function is_control_line(line) {
                return line ~ /^[[:space:]]*(if|for|while|switch|foreach|catch|elseif)[[:space:]]*\(/
            }
            function is_closure_arg(line) {
                if (line !~ /function/) return 0
                return index(line, "(") < (match(line, /(^|[^A-Za-z0-9_])function[[:space:]]*\(/) ? (RSTART == 1 ? 1 : RSTART + 1) : 0)
            }
            function is_function_start(line) {
                if (!php && line !~ /^[A-Za-z_]/) return 0
                return line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^\)]*$/ &&
                    line !~ /;[[:space:]]*$/ &&
                    line !~ /\([^)]*->/ &&
                    !is_control_line(line)
            }
            function is_function_return_type(line) {
                return line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]]*\*+[[:space:]]*$/
            }
            function is_function_signature(line) {
                if (!php && line !~ /^[A-Za-z_]/) return 0
                return (line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^;]*\)[^;{]*$/ &&
                        line !~ /\)[[:space:]]*[!<>=+\-*\/%&|^?:.,)]/ &&
                        line !~ /\([^)]*->/ &&
                        !is_control_line(line)) ||
                    (line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^;]*\)[[:space:]]*:[[:space:]]*[A-Za-z_\\?&|\[\]0-9<>:,. ]+$/ &&
                        line !~ /\([^)]*->/ &&
                        !is_control_line(line))
            }
            function is_function_single(line) {
                if (!php && line !~ /^[A-Za-z_]/) return 0
                return (line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^;]*\)[^;{]*\{[[:space:]]*$/ &&
                        line !~ /\)[^;{]*[=!<>&|?:)+-][^;{]*\{/ &&
                        !is_control_line(line)) ||
                    (line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*\([^;]*\)[[:space:]]*:[[:space:]]*[A-Za-z_\\?&|\[\]0-9<>:,. ]+\{[[:space:]]*$/ &&
                        !is_control_line(line))
            }
            /^[[:space:]]*\/\*\*/ {
                in_docblock = 1
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /\* (Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /\* [A-Za-z]/) {
                    seen_summary = 1
                }
                next
            }
            in_docblock {
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /\* (Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /\* [A-Za-z]/) {
                    seen_summary = 1
                }
                if ($0 ~ /\*\//) {
                    in_docblock = 0
                    docblock_ready = 1
                }
                next
            }
            /^[[:space:]]*$/ {
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            /^[[:space:]]*#/ { next }
            pending_function && /^[[:space:]]*\{/ {
                if (!docblock_ready || !seen_return || !seen_summary) { print pending_line; exit }
                pending_function = 0
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            pending_function {
                if ($0 ~ /;[[:space:]]*$/) {
                    pending_function = 0
                    docblock_ready = 0
                    seen_return = 0
                    seen_summary = 0
                    next
                }
                if ($0 ~ /\)[^;{]*\{/) {
                    if (!docblock_ready || !seen_return || !seen_summary) { print pending_line; exit }
                    pending_function = 0
                    docblock_ready = 0
                    seen_return = 0
                    seen_summary = 0
                    next
                }
                next
            }
            docblock_ready && is_function_return_type($0) {
                next
            }
            is_function_single($0) {
                if (is_closure_arg($0) || pending_function) next
                if ($0 ~ /^[[:space:]]*(return|throw|new|match)[[:space:]\(]/) next
                if (!docblock_ready || !seen_return || !seen_summary) { print NR; exit }
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            is_function_start($0) {
                if (is_closure_arg($0)) next
                pending_function = 1
                pending_line = NR
                next
            }
            is_function_signature($0) {
                if (is_closure_arg($0)) next
                pending_function = 1
                pending_line = NR
                next
            }
            {
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Missing function DocBlock, summary, or @return."
    elif [ "$ftype" = "js" ]; then
        bad_line=$(awk '
            BEGIN { sq = sprintf("%c", 39) }
            function is_functionish(line) {
                if (line ~ /(async[[:space:]]+)?function\*?[[:space:]]+[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*\(/) return 1
                if (line ~ /(const|let|var)[[:space:]]+[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*=[[:space:]]*(async[[:space:]]+)?function[[:space:]]*\(/) return 1
                if (line ~ /(const|let|var)[[:space:]]+[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*=[[:space:]]*(async[[:space:]]+)?(\([^;]*\)|[A-Za-z_$][A-Za-z0-9_$]*)[[:space:]]*=>/) return 1
                if (line ~ /^[[:space:]]*(export[[:space:]]+default[[:space:]]+)?(async[[:space:]]+)?\([^;]*\)[[:space:]]*=>/) return 1
                if (line ~ /^[[:space:]]*(static[[:space:]]+)?(async[[:space:]]+)?#?[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*\([^)]*\)[[:space:]]*\{/ && line !~ /^[[:space:]]*(if|for|while|switch|catch|else)[[:space:]]*\(/ && line !~ /\([[:space:]]*function[[:space:]]*\(/) return 1
                return 0
            }
            function is_complete(line) {
                return (line ~ /[;{}]/)
            }
            /^[[:space:]]*\/\*\*/ {
                in_docblock = 1
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /\* (Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /\* [A-Za-z]/) {
                    seen_summary = 1
                }
                next
            }
            in_docblock {
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /\* (Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /\* [A-Za-z]/) {
                    seen_summary = 1
                }
                if ($0 ~ /\*\//) {
                    in_docblock = 0
                    docblock_ready = 1
                }
                next
            }
            /^[[:space:]]*$/ {
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            pending && /^[[:space:]]*\{/ {
                if (!docblock_ready || !seen_return || !seen_summary) { print pending_line; exit }
                pending = 0
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
                next
            }
            pending {
                if ($0 ~ /;[[:space:]]*$/ || $0 ~ /[^;]*\{/) {
                    if (!docblock_ready || !seen_return || !seen_summary) { print pending_line; exit }
                    pending = 0
                    docblock_ready = 0
                    seen_return = 0
                    seen_summary = 0
                    next
                }
                next
            }
            is_functionish($0) {
                if (is_complete($0)) {
                    if (!docblock_ready || !seen_return || !seen_summary) { print NR; exit }
                    docblock_ready = 0
                    seen_return = 0
                    seen_summary = 0
                } else {
                    pending = 1
                    pending_line = NR
                }
                next
            }
            {
                docblock_ready = 0
                seen_return = 0
                seen_summary = 0
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Missing function DocBlock, summary, or @return."
    elif [ "$ftype" = "lua" ]; then
        bad_line=$(awk '
            /^[[:space:]]*--/ {
                if ($0 ~ /@return/) {
                    seen_return = 1
                } else if ($0 !~ /@param/ && $0 !~ /@return/ && $0 !~ /-- (Summary:|Author:|Website:|License:|Email:|©)/ && $0 ~ /-- [A-Za-z]/) {
                    seen_summary = 1
                }
                in_docblock = 1
                next
            }
            in_docblock && !/^[[:space:]]*--/ {
                in_docblock = 0
                if (seen_return && seen_summary) {
                    docblock_ready = 1
                }
                seen_return = 0
                seen_summary = 0
            }
            /^[[:space:]]*$/ {
                in_docblock = 0
                seen_return = 0
                seen_summary = 0
                docblock_ready = 0
                next
            }
            /^function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/ {
                if (!docblock_ready) { print NR; exit }
                docblock_ready = 0
                next
            }
            /^local[[:space:]]+function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/ {
                if (!docblock_ready) { print NR; exit }
                docblock_ready = 0
                next
            }
            /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*function[[:space:]]*\(/ {
                if (!docblock_ready) { print NR; exit }
                docblock_ready = 0
                next
            }
        ' "$file_path")
        [ -n "$bad_line" ] && fail "$file_path:$bad_line Missing function DocBlock, summary, or @return."
    fi
    pass "$file_path: Function DocBlocks verified."
}

# Expands files and directories into a flat validation list.
# @param args List of files or directories to validate.
# @return 0 on success.
collect_artifacts() {
    local arg ignorefile
    for arg in "$@"; do
        if [ -f "$arg" ]; then
            printf '%s\0' "$arg"
            continue
        fi
        if [ -d "$arg" ]; then
            ignorefile="$arg/.kcsignore"
            if [ -f "$ignorefile" ]; then
                while IFS= read -r line; do
                    case "$line" in
                        ''|\#*) continue ;;
                        *) KC_KCS_EXCLUDES+=("$line") ;;
                    esac
                done < "$ignorefile"
            fi
            local find_cmd=(find "$arg" -mindepth 1)
            find_cmd+=(\( -type d \( -path '*/lib/inc' -o -path '*/lib/obj' -o -path '*/vendor' -o -path '*/vendors' -o -path '*/third_party' -o -path '*/third-party' \) \) -prune -o)
            find_cmd+=(\( -type d -name '.*' -o -type f -name '.*' \) -prune -o)
            for exc in "${KC_KCS_EXCLUDES[@]}"; do
                find_cmd+=(\( -path "*$exc*" \) -prune -o)
            done
            find_cmd+=(-type f -print0)
            "${find_cmd[@]}"
        fi
    done
}

# Ensures no numbered or ornamented outputs.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success, fails otherwise.
validate_no_numbered_or_ornamented_outputs() {
    local file_path="$1"
    local ftype="$2"
    local bad_line
    local AWK_HELPERS='
        function has_ornament(str) {
            if (str ~ /(===|---|[\*]{3}|___|###|[\+]{3}|~~~)/) return 1
            if (str ~ /(==|--|[\*]{2}|__|##|[\+]{2}|~~)[[:space:]]+[a-zA-Z0-9_[:space:]]+[[:space:]]+(==|--|[\*]{2}|__|##|[\+]{2}|~~)/) return 1
            if (str ~ /(->|=>|-->|==>|<-|<=|<->|<==>)/) return 1
            gsub(/\xc2\xa9/, "", str)
            if (str ~ /[^\x00-\x7F]/) return 1
            return 0
        }
        function first_quoted_part(line,    n, parts) {
            n = split(line, parts, /[\x27\x22\x60]/)
            if (n >= 2) return parts[2]
            return ""
        }
        function has_numbered_prefix(str) {
            return str ~ /^[[:space:]]*(\\[a-zA-Z])*[[:space:]]*[0-9]+[\.\)]/
        }
        function check_line_for_ornaments(line,    n, parts, i) {
            n = split(line, parts, /[\x27\x22\x60]/)
            for (i = 2; i <= n; i += 2) {
                if (has_ornament(parts[i])) return 1
            }
            return 0
        }
        function check_first_quoted_part(line,    text) {
            text = first_quoted_part(line)
            if (text == "") return 0
            if (has_numbered_prefix(text)) return 1
            if (has_ornament(text)) return 1
            return 0
        }
    '
    case "$ftype" in
        markdown)
            bad_line=$(awk '
                '"$AWK_HELPERS"'
                /^```/ { in_fence = !in_fence; next }
                in_fence { next }
                /^[[:space:]]*#+[[:space:]]+/ {
                    heading = $0
                    sub(/^[[:space:]]*#+[[:space:]]+/, "", heading)
                    if (heading ~ /^[0-9]+[\.\)]/) { print NR; exit }
                    if (has_ornament(heading)) { print NR; exit }
                }
            ' "$file_path")
            if [ -n "$bad_line" ]; then
                fail "$file_path:$bad_line Headings must not be numbered or contain ornaments."
            fi
            ;;
        shell)
            bad_line=$(awk '
                '"$AWK_HELPERS"'
                function start_heredoc(line,    rest, quote, squote) {
                    if (line !~ /<<-?/) return 0
                    rest = line
                    sub(/^.*<<-?/, "", rest)
                    sub(/^[[:space:]]*/, "", rest)
                    squote = sprintf("%c", 39)
                    quote = substr(rest, 1, 1)
                    if (quote == "\"" || quote == squote) {
                        rest = substr(rest, 2)
                        sub(quote ".*$", "", rest)
                        heredoc = rest
                        return 1
                    }
                    if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
                        heredoc = substr(rest, RSTART, RLENGTH)
                        return 1
                    }
                    return 0
                }
                heredoc {
                    end = $0
                    sub(/^[[:space:]]*/, "", end)
                    if (end == heredoc) heredoc = ""
                    next
                }
                /^[[:space:]]*#/ {
                    comment = $0
                    sub(/^[[:space:]]*#/, "", comment)
                    if (has_ornament(comment)) { print NR; exit }
                }
                /^[[:space:]]*(echo|printf|log_[a-z0-9_]+|kc_log_[a-z0-9_]+)[[:space:]]+/ {
                    if (check_first_quoted_part($0)) { print NR; exit }
                }
                { start_heredoc($0) }
            ' "$file_path")
            if [ -n "$bad_line" ]; then
                fail "$file_path:$bad_line Print/echo statements and comments must not contain numbered messages or ornaments."
            fi
            ;;
        c|php)
            bad_line=$(awk '
                '"$AWK_HELPERS"'
                /^[[:space:]]*\/\*/ { in_comment = 1; comment = $0; sub(/^[[:space:]]*\/\*/, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /^[[:space:]]*\*\// { in_comment = 0; comment = $0; sub(/^[[:space:]]*\*\//, "", comment); if (has_ornament(comment)) { print NR; exit } }
                in_comment && /^[[:space:]]*\*/ { comment = $0; sub(/^[[:space:]]*\*/, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /^[[:space:]]*\/\// { comment = $0; sub(/^[[:space:]]*\/\//, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /(printf|fprintf|sprintf|snprintf|kc_log|log_[a-z0-9_]+|echo)[[:space:]]*\(/ {
                    if (check_first_quoted_part($0)) { print NR; exit }
                }
                /^[[:space:]]*echo[[:space:]]+/ {
                    if (check_first_quoted_part($0)) { print NR; exit }
                }
            ' "$file_path")
            if [ -n "$bad_line" ]; then
                fail "$file_path:$bad_line C/PHP prints/logs and comments must not contain numbered messages or ornaments."
            fi
            ;;
        js)
            bad_line=$(awk '
                '"$AWK_HELPERS"'
                /^[[:space:]]*\/\*/ { in_comment = 1; comment = $0; sub(/^[[:space:]]*\/\*/, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /^[[:space:]]*\*\// { in_comment = 0; comment = $0; sub(/^[[:space:]]*\*\//, "", comment); if (has_ornament(comment)) { print NR; exit } }
                in_comment && /^[[:space:]]*\*/ { comment = $0; sub(/^[[:space:]]*\*/, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /^[[:space:]]*\/\// { comment = $0; sub(/^[[:space:]]*\/\//, "", comment); if (has_ornament(comment)) { print NR; exit } }
                /(console\.[a-z]+|print|printf)[[:space:]]*\(/ {
                    if (check_first_quoted_part($0)) { print NR; exit }
                }
            ' "$file_path")
            if [ -n "$bad_line" ]; then
                fail "$file_path:$bad_line JS prints/logs and comments must not contain numbered messages or ornaments."
            fi
            ;;
        lua)
            bad_line=$(awk '
                '"$AWK_HELPERS"'
                /^[[:space:]]*--/ {
                    comment = $0
                    sub(/^[[:space:]]*--/, "", comment)
                    if (has_ornament(comment)) { print NR; exit }
                }
                /(print|printf|io\.write)[[:space:]]*\(/ {
                    if (check_first_quoted_part($0)) { print NR; exit }
                }
            ' "$file_path")
            if [ -n "$bad_line" ]; then
                fail "$file_path:$bad_line Lua prints and comments must not contain numbered messages or ornaments."
            fi
            ;;
    esac
    pass "$file_path: Numbered and ornamented output rules verified."
}

# Validates that the em dash character is not used.
# Hyphen "-" must be used instead.
# @param file_path Path to the file.
# @return 0 on success, fails otherwise.
validate_no_em_dash() {
    local file_path="$1"
    local bad_line
    bad_line=$(grep -n $'\xe2\x80\x94' "$file_path" | head -n 1 | cut -d: -f1 || true)
    if [ -n "$bad_line" ]; then
        fail "$file_path:$bad_line Em dash character is forbidden; use hyphen \"-\" instead."
    fi
    pass "$file_path: No em dash characters."
}

# Validates that files begin with the KaisarCode header block.
# @param file_path Path to the file.
# @param ftype File type identified.
# @return 0 on success, fails otherwise.
kc_validate_header() {
    local file_path="$1"
    local ftype="$2"
    local bad_line
    case "$ftype" in
        shell)
            bad_line=$(awk '
                NR == 1 && /^#!/ { next }
                /^#/ {
                    if (/^# Summary:/) { seen["Summary"] = NR; next }
                    if (/^# Author:/) { seen["Author"] = NR; next }
                    if (/^# Website:/) { seen["Website"] = NR; next }
                    if (/^# License:/) { seen["License"] = NR; next }
                    if (/^# /) { if (!seen["Title"]) seen["Title"] = NR; next }
                    print NR; exit
                }
                { exit }
                END {
                    if (!seen["Summary"] || !seen["Author"] || !seen["Website"] || !seen["License"]) {
                        print "missing"; exit
                    }
                    if (seen["Title"] && seen["Title"] > seen["Summary"]) {
                        print seen["Title"]; exit
                    }
                    if (seen["Summary"] > seen["Author"] || seen["Author"] > seen["Website"] || seen["Website"] > seen["License"]) {
                        print "order"; exit
                    }
                }
            ' "$file_path" || true)
            if [ -n "$bad_line" ]; then
                [[ "$bad_line" =~ ^[0-9]+$ ]] || bad_line=1
                fail "$file_path:$bad_line Missing or malformed KaisarCode header."
            fi
            ;;
        c)
            bad_line=$(awk '
                NR == 1 && $0 !~ /^[[:space:]]*\/\*\*/ { print NR; exit }
                /^[[:space:]]*\/\*\*/ {
                    if (state > 0) { print NR; exit }
                    state = 1
                    next
                }
                state == 1 && /^ \* Summary:/ { state = 2; next }
                state == 1 && /^ \* Author:/ { state = 4; next }
                state == 1 && /^ \*$/ { state = 3; next }
                state == 1 && /^ \* / { next }
                state == 2 && /^ \* Author:/ { state = 4; next }
                state == 2 && /^ \*$/ { state = 3; next }
                state == 2 && /^ \* / { next }
                state == 3 && /^ \* Author:/ { state = 4; next }
                state == 4 && /^ \* Website:/ { state = 5; next }
                state == 5 && /^ \* License:/ { state = 6; next }
                state == 6 && /^[[:space:]]*\*\// { state = 0; next }
                { if (state > 0) { print NR; failed = 1 } exit }
                END { if (state > 0 && !failed) print "end-of-file" }
            ' "$file_path" || true)
            if [ -n "$bad_line" ]; then
                [[ "$bad_line" =~ ^[0-9]+$ ]] || bad_line=1
                fail "$file_path:$bad_line Missing or malformed KaisarCode header."
            fi
            ;;
        php)
            bad_line=$(awk '
                BEGIN { state = 0; skip = 0 }
                NR == 1 && /^[[:space:]]*<\?php/ { skip = 1; next }
                {
                    adj = NR - skip
                    if (adj == 1) {
                        if ($0 !~ /^[[:space:]]*\/\*\*/) { print NR; exit }
                        state = 1
                        next
                    }
                }
                state == 1 && /^ \* Summary:/ { state = 2; next }
                state == 1 && /^ \* Author:/ { state = 4; next }
                state == 1 && /^ \*$/ { state = 3; next }
                state == 1 && /^ \* / { next }
                state == 2 && /^ \* Author:/ { state = 4; next }
                state == 2 && /^ \*$/ { state = 3; next }
                state == 3 && /^ \* Author:/ { state = 4; next }
                state == 4 && /^ \* Website:/ { state = 5; next }
                state == 5 && /^ \* License:/ { state = 6; next }
                state == 6 && /^[[:space:]]*\*\// { state = 0; next }
                { if (state > 0) print NR; exit }
                END { if (state > 0) print "end-of-file" }
            ' "$file_path" || true)
            if [ -n "$bad_line" ]; then
                [[ "$bad_line" =~ ^[0-9]+$ ]] || bad_line=1
                fail "$file_path:$bad_line Missing or malformed KaisarCode header."
            fi
            ;;
        js)
            bad_line=$(awk '
                BEGIN { state = 0; skip = 0 }
                NR == 1 && /^#!.*/ { skip = 1; next }
                {
                    adj = NR - skip
                    if (adj == 1) {
                        if ($0 !~ /^[[:space:]]*\/\*\*/) { print NR; exit }
                        state = 1
                        next
                    }
                }
                state == 1 && /^ \* Summary:/ { state = 2; next }
                state == 1 && /^ \* Author:/ { state = 4; next }
                state == 1 && /^ \*$/ { state = 3; next }
                state == 1 && /^ \* / { next }
                state == 2 && /^ \* Author:/ { state = 4; next }
                state == 2 && /^ \*$/ { state = 3; next }
                state == 3 && /^ \* Author:/ { state = 4; next }
                state == 4 && /^ \* Website:/ { state = 5; next }
                state == 5 && /^ \* License:/ { state = 6; next }
                state == 6 && /^[[:space:]]*\*\// { state = 0; next }
                { if (state > 0) print NR; exit }
                END { if (state > 0) print "end-of-file" }
            ' "$file_path" || true)
            if [ -n "$bad_line" ]; then
                [[ "$bad_line" =~ ^[0-9]+$ ]] || bad_line=1
                fail "$file_path:$bad_line Missing or malformed KaisarCode header."
            fi
            ;;
        lua)
            bad_line=$(awk '
                NR == 1 && /^#!/ { next }
                /^--/ {
                    if (/^-- Summary:/) { seen["Summary"] = NR; next }
                    if (/^-- Author:/) { seen["Author"] = NR; next }
                    if (/^-- Website:/) { seen["Website"] = NR; next }
                    if (/^-- License:/) { seen["License"] = NR; next }
                    if (/^-- /) { if (!seen["Title"]) seen["Title"] = NR; next }
                    print NR; exit
                }
                { exit }
                END {
                    if (!seen["Summary"] || !seen["Author"] || !seen["Website"] || !seen["License"]) {
                        print "missing"; exit
                    }
                    if (seen["Title"] && seen["Title"] > seen["Summary"]) {
                        print seen["Title"]; exit
                    }
                    if (seen["Summary"] > seen["Author"] || seen["Author"] > seen["Website"] || seen["Website"] > seen["License"]) {
                        print "order"; exit
                    }
                }
            ' "$file_path" || true)
            if [ -n "$bad_line" ]; then
                [[ "$bad_line" =~ ^[0-9]+$ ]] || bad_line=1
                fail "$file_path:$bad_line Missing or malformed KaisarCode header."
            fi
            ;;
    esac
    pass "$file_path: KaisarCode header verified."
}

# Main entry point for the validator lifecycle.
# @param args List of files or directories to validate.
# @return 0 on success.
run_validator() {
    local artifacts=()
    local artifact
    while IFS= read -r -d '' artifact; do
        artifacts+=("$artifact")
    done < <(collect_artifacts "$@")
    [ "${#artifacts[@]}" -gt 0 ] || kc_kcs_fail "No valid files or directories were provided." || return 1
    for artifact in "${artifacts[@]}"; do
        local ftype
        ftype=$(get_file_type "$artifact")
        [ "$ftype" = "unknown" ] && continue
        if [[ "$(basename "$artifact")" == "CHANGELOG.md" ]]; then
            continue
        fi
        validate_filename "$artifact"
        validate_no_em_dash "$artifact"
        kc_validate_header "$artifact" "$ftype"
        validate_whitespace_and_limits "$artifact"
        validate_no_internal_comments "$artifact" "$ftype"
        validate_docblock_spacing "$artifact" "$ftype"
        validate_no_duplicate_docblocks "$artifact" "$ftype"
        validate_function_docblocks "$artifact" "$ftype"
        validate_docblock_format "$artifact"
        validate_no_numbered_or_ornamented_outputs "$artifact" "$ftype"
        case "$ftype" in
            shell)
                validate_shell_rules "$artifact"
                ;;
            markdown)
                validate_markdown_rules "$artifact"
                ;;
        esac
    done
    [ "$KC_KCS_FAILURE_COUNT" -eq 0 ]
}

# Main entry point.
# @return 0 on success, 1 on failure.
main() {
    local force_type=""
    local excludes=()
    local filtered_args=()
    local arg

    KC_KCS_FAILURE_COUNT=0
    KC_KCS_STOP_ON_FAILURE=0
    KC_KCS_SHOW_PASS=0

    for arg in "$@"; do
        case "$arg" in
            -s|--stop)
                KC_KCS_STOP_ON_FAILURE=1
                ;;
            -p|--pass)
                KC_KCS_SHOW_PASS=1
                ;;
            *)
                filtered_args+=("$arg")
                ;;
        esac
    done
    set -- "${filtered_args[@]}"

    if [ -f ".kcsignore" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// /}" ]] && continue
            excludes+=("$line")
        done < ".kcsignore"
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help)
                kc_kcs_help
                return 0
                ;;
            -type)
                shift
                [ -n "$1" ] || kc_kcs_fail "Missing value for -type." || return 1
                force_type="$(normalize_file_type "$1")" || \
                kc_kcs_fail "Invalid value for -type." || return 1
                ;;
            -e|--exclude)
                shift
                [ -n "$1" ] || kc_kcs_fail "Missing value for --exclude." || return 1
                excludes+=("$1")
                ;;
            *)
                break
                ;;
        esac
        shift
    done

    [ "$#" -gt 0 ] || set -- "."
    export KC_KCS_FORCE_TYPE="$force_type"
    KC_KCS_EXCLUDES=("${excludes[@]}")
    if run_validator "$@"; then
        printf "OK\n"
        return 0
    fi
    return 1
}

main "$@"